// CardVault AI — Universal collectibles schema (Pokémon TCG first, expandable)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  avatarUrl     String?
  plan          Plan     @default(FREE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collections   Collection[]
  assets        Asset[]
  transactions  Transaction[]
  expenses      Expense[]
  watchlists    Watchlist[]
  priceAlerts   PriceAlert[]
  aiScans       AIScan[]
  taxRecords    TaxRecord[]
  integrations  Integration[]
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model Collection {
  id          String              @id @default(cuid())
  userId      String
  name        String
  description String?
  category    CollectibleCategory @default(POKEMON_TCG)
  createdAt   DateTime            @default(now())

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets      Asset[]
}

enum CollectibleCategory {
  POKEMON_TCG
  SPORTS_CARDS
  ONE_PIECE_TCG
  MAGIC_THE_GATHERING
  YUGIOH
  FUNKO_POP
  SEALED
  COMIC
  VIDEO_GAME
}

// Universal asset model — works for all collectible categories
model Asset {
  id             String              @id @default(cuid())
  userId         String
  collectionId   String?
  category       CollectibleCategory @default(POKEMON_TCG)

  name           String
  imageUrl       String?
  quantity       Int                 @default(1)
  costBasis      Decimal             @db.Decimal(10, 2)
  currentValue   Decimal             @db.Decimal(10, 2)
  notes          String?
  tags           String[]
  acquiredAt     DateTime
  acquiredFrom   String
  isWatchlisted  Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // TCG-specific (nullable for non-TCG categories)
  cardSet        String?
  setCode        String?
  cardNumber     String?
  rarity         String?
  grade          String?
  gradeCompany   String?
  certNumber     String?
  language       String?             @default("English")
  isSealed       Boolean             @default(false)

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection     Collection?  @relation(fields: [collectionId], references: [id])
  transactions   Transaction[]
  priceHistory   PriceHistory[]
  aiScans        AIScan[]

  @@index([userId, category])
  @@index([userId, cardSet])
}

model Transaction {
  id        String          @id @default(cuid())
  userId    String
  assetId   String
  type      TransactionType
  date      DateTime
  platform  String
  price     Decimal         @db.Decimal(10, 2)
  fees      Decimal         @db.Decimal(10, 2) @default(0)
  shipping  Decimal         @db.Decimal(10, 2) @default(0)
  quantity  Int             @default(1)
  notes     String?
  createdAt DateTime        @default(now())

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset @relation(fields: [assetId], references: [id])

  @@index([userId, type])
  @@index([userId, date])
}

enum TransactionType {
  BUY
  SELL
  TRADE_IN
  TRADE_OUT
  GIFT
  PACK_PULL
}

model PriceHistory {
  id      String   @id @default(cuid())
  assetId String
  date    DateTime
  price   Decimal  @db.Decimal(10, 2)
  source  String
  volume  Int?
  grade   String?

  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, date])
}

model Expense {
  id          String          @id @default(cuid())
  userId      String
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime
  receiptUrl  String?
  createdAt   DateTime        @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

enum ExpenseCategory {
  CARD_PURCHASES
  SHIPPING_SUPPLIES
  POSTAGE
  GRADING_FEES
  PLATFORM_FEES
  TRAVEL
  EQUIPMENT
  SUBSCRIPTION
  OTHER
}

model TaxRecord {
  id               String   @id @default(cuid())
  userId           String
  year             Int
  totalRevenue     Decimal  @db.Decimal(12, 2)
  costOfGoods      Decimal  @db.Decimal(12, 2)
  grossProfit      Decimal  @db.Decimal(12, 2)
  expenses         Decimal  @db.Decimal(12, 2)
  netIncome        Decimal  @db.Decimal(12, 2)
  shortTermGains   Decimal  @db.Decimal(12, 2)
  longTermGains    Decimal  @db.Decimal(12, 2)
  estimatedTax     Decimal  @db.Decimal(12, 2)
  lastCalculatedAt DateTime @default(now())

  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  cardIds   String[]
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PriceAlert {
  id          String         @id @default(cuid())
  userId      String
  cardName    String
  targetPrice Decimal        @db.Decimal(10, 2)
  direction   AlertDirection
  triggered   Boolean        @default(false)
  triggeredAt DateTime?
  createdAt   DateTime       @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AlertDirection {
  ABOVE
  BELOW
}

model AIScan {
  id             String     @id @default(cuid())
  userId         String
  imageUrl       String
  status         ScanStatus @default(PENDING)
  detectedCards  Json?
  importedAssets String[]
  assetId        String?
  createdAt      DateTime   @default(now())

  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset          Asset? @relation(fields: [assetId], references: [id])
}

enum ScanStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model Integration {
  id           String              @id @default(cuid())
  userId       String
  platform     IntegrationPlatform
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

enum IntegrationPlatform {
  WHATNOT
  TCGPLAYER
  EBAY
  PSA
}
